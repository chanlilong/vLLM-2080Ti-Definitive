# EXPERIMENTAL - not validated. Many-user chat shape: 8 concurrent requests,
# 49,152-token context each, FP8 KV. Derived from the validated
# 2x2080Ti/qwen27b/w4a16/mtp4-fp8kv-2x229K-text-only.env route parameters.
# The launcher refuses to start if GPU KV tokens < MAX_NUM_SEQS x MAX_MODEL_LEN.
MODEL_FAMILY=qwen35
MODEL_VARIANT=nvfp4
QUANTIZATION=compressed-tensors
KV_CACHE_DTYPE=fp8
MAX_MODEL_LEN=49152
GPU_UTIL=0.94
MAX_NUM_SEQS=8
MESSAGE_TYPE=text-only
SPECULATIVE_METHOD=mtp
SPECULATIVE_TOKENS=4
