# EXPERIMENTAL - not validated on TITAN RTX. Same route shape as the validated
# 2x2080Ti/qwen27b/w4a16/mtp4-tq4nc-3x262K-text-only.env (22 GB cards).
# Three concurrent requests at the full native 262K context.
MODEL_FAMILY=qwen35
MODEL_VARIANT=nvfp4
QUANTIZATION=compressed-tensors
KV_CACHE_DTYPE=turboquant_4bit_nc
MAX_MODEL_LEN=262144
GPU_UTIL=0.95
MAX_NUM_SEQS=3
MESSAGE_TYPE=text-only
SPECULATIVE_METHOD=mtp
SPECULATIVE_TOKENS=4
